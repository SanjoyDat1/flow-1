# Penlo Local Pipeline — environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get an Anthropic API key at: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Enterprise Brain ingestion credential (pb_live hex key).
# Leave as placeholder for local-only extraction; set when sync is ready.
PENLO_API_KEY=pb_live_REPLACE_ME

# Optional: email stamped onto each payload for identity association.
PENLO_USER_EMAIL=you@company.com
